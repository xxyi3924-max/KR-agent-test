# Agent Trader - Example Environment Variables
# Copy to .env and fill in your values

# KR Broker (Kaigora) API
KR_BROKER_API_KEY=your_api_key_here
KR_BROKER_API_URL=https://kaigora.com/api/v1

# Paths (override config.yaml)
TDASH_DATA_DIR=~/Documents/trading_dashboard_v9/data
KR_BROKER_DB=~/Documents/esc190f/kr-broker/kr_broker.db

# Optional: Logging
LOG_LEVEL=INFO
